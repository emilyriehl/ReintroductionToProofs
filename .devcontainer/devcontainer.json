{
  "forwardPorts": [3000],
  "build": {"dockerfile": "Dockerfile"},
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/node/game,type=bind,consistency=cached",
  "workspaceFolder": "/home/node/game",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/run-server.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": false
      },
      "extensions": [
        "leanprover.lean4"
      ]
    },
    "codespaces": {
      "openFiles": ["Game.lean"]
    }
  }
}
